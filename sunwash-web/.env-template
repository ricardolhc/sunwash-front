# ==========================================
# SunWash Frontend - Variáveis de Ambiente
# ==========================================

# Título da Aplicação
VITE_APP_TITLE="SunWash - Limpeza de Placas Solares & Drone"

# URL base da API Backend (Java/Spring Boot ou Node.js)
VITE_API_URL=http://localhost:8080/api

# Forçar uso dos Gateways HTTP em ambiente de desenvolvimento (true para HTTP, false para Memory Mock)
VITE_USE_HTTP=true

# Ambiente da aplicação (development | production | test)
VITE_ENVIRONMENT=development

# Configuração de Provedor de Pagamento (Mock / Stripe / Mercado Pago)
VITE_PAYMENT_GATEWAY_PROVIDER=STRIPE_MERCADO_PAGO
VITE_STRIPE_PUBLIC_KEY=pk_test_sample_key_here
VITE_ADMIN_API_TOKEN=change-me

# Chave pública / Endpoints adicionais para Drone ou Serviços de Armazenamento (S3/Cloudinary)
VITE_STORAGE_UPLOAD_URL=http://localhost:8080/api/upload
